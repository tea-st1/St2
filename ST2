        Size = UDim2.new(0, 160, 0, newHeight)
    }):Play()
    
    self.ContentContainer.Size = UDim2.new(1, 0, 1, -30)
    
    function section:CreateToggle(text, callback)
        local btn = Instance.new("TextButton")
        btn.Name = "ToggleBtn_" .. text
        
        local buttonIndex = #section.Buttons
        local row = math.floor(buttonIndex / 2)
        local col = buttonIndex % 2
        btn.Size = UDim2.new(0.5, 0, 0, 30)
        btn.Position = UDim2.new(col * 0.5, col * 0, 0, row * 30)
        btn.BackgroundColor3 = Color3.fromRGB(44, 44, 50)
        btn.BackgroundTransparency = 0
        btn.Parent = section.Content
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 4)
        corner.Parent = btn
        
        local btnText = Instance.new("TextLabel")
        btnText.Size = UDim2.new(1, 0, 1, 0)
        btnText.Position = UDim2.new(0, 0, 0, 0)
        btnText.BackgroundTransparency = 1
        btnText.Text = text
        btnText.Font = Enum.Font.SourceSans
        btnText.TextSize = 14
        btnText.TextColor3 = Color3.fromRGB(255, 255, 255)
        btnText.TextXAlignment = Enum.TextXAlignment.Center
        btnText.Parent = btn
        
        local toggleState = false
        
        btn.MouseButton1Click:Connect(function()
            toggleState = not toggleState
            local newColor = toggleState and Color3.fromRGB(60, 180, 60) or Color3.fromRGB(44, 44, 50)
            TweenService:Create(btn, TweenInfo.new(0.1), {
                BackgroundColor3 = newColor
            }):Play()
            task.spawn(function()
                callback(toggleState)
            end)
        end)
        
        if col == 0 then
            section.ContentY = section.ContentY + 30
        end
        table.insert(section.Buttons, btn)
        return btn
    end
    
    section.ToggleBtn.MouseButton1Click:Connect(function()
        section.IsExpanded = not section.IsExpanded
        if section.IsExpanded then
            section.ToggleBtn.Text = "-"
            TweenService:Create(section.Content, TweenInfo.new(0.2), { Size = UDim2.new(1, 0, 0, section.ContentY) }):Play()
            self.CurrentY = self.CurrentY + section.ContentY
        else
            section.ToggleBtn.Text = "+"
            TweenService:Create(section.Content, TweenInfo.new(0.2), { Size = UDim2.new(1, 0, 0, 0) }):Play()
            self.CurrentY = self.CurrentY - section.ContentY
        end
        
        for _, sec in ipairs(self.Sections) do
            if sec ~= section and sec.Frame.Position.Y.Offset > section.Frame.Position.Y.Offset then
                TweenService:Create(sec.Frame, TweenInfo.new(0.2), {
                    Position = UDim2.new(0, 0, 0, sec.Frame.Position.Y.Offset + (section.IsExpanded and section.ContentY or -section.ContentY))
                }):Play()
                TweenService:Create(sec.Content, TweenInfo.new(0.2), {
                    Position = UDim2.new(0, 0, 0, sec.Content.Position.Y.Offset + (section.IsExpanded and section.ContentY or -section.ContentY))
                }):Play()
            end
        end
        
        local newHeight = math.max(160, 30 + self.CurrentY + 5)
        TweenService:Create(self.Window, TweenInfo.new(0.2), { Size = UDim2.new(0, 160, 0, newHeight) }):Play()
    end)
    
    table.insert(self.Sections, section)
    return section
end

