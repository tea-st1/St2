local autoeat = false
local fc, cc
local mapFolder, chunksFolder

local function stopFarm()
    farm = false
    if fc then fc:Disconnect(); fc = nil end
    local b = workspace:FindFirstChild("ETW_AutoFarmBedrock")
    if b then b:Destroy() end

    if mapFolder then mapFolder.Parent = workspace end
    if chunksFolder then chunksFolder.Parent = workspace end
end

local function startFarm()
    if fc then fc:Disconnect() end
    local c = LocalPlayer.Character
    if not c then return end
    local h = c:FindFirstChild("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    local s = c:FindFirstChild("Size")
    local e = c:FindFirstChild("Events")
    local ch = c:FindFirstChild("CurrentChunk")
    local st = c:FindFirstChild("SendTrack")
    local rad = c:FindFirstChild("Radius")
    
    if not (h and r and s and e and ch and st and rad) then return end
    local eat = e:FindFirstChild("Eat")
    local grab = e:FindFirstChild("Grab")
    local sell = e:FindFirstChild("Sell")
    if not (eat and grab and sell) then return end
    
    local bed = Instance.new("Part")
    bed.Name = "ETW_AutoFarmBedrock"
    bed.Anchored = true
    bed.Size = Vector3.new(2048, 10, 2048)
    bed.Position = Vector3.new(0, -5, 0)
    bed.Parent = workspace
    
    local n, t, g = 0, 0, 0
    
    local m = workspace:FindFirstChild("Map")
    local chk = workspace:FindFirstChild("Chunks")
    if m then mapFolder = m; m.Parent = nil end
    if chk then chunksFolder = chk; chk.Parent = nil end

    fc = RunService.Heartbeat:Connect(function(dt)
        if not farm or not c.Parent or h.Health <= 0 then stopFarm(); return end

        if workspace:FindFirstChild("Loading") then
            workspace.Loading:Destroy()
        end
        local currentMap = workspace:FindFirstChild("Map")
        local currentChunks = workspace:FindFirstChild("Chunks")
        if currentMap then mapFolder = currentMap; currentMap.Parent = nil end
        if currentChunks then chunksFolder = currentChunks; currentChunks.Parent = nil end

        local up = LocalPlayer:FindFirstChild("Upgrades")
        local max = up and up:FindFirstChild("MaxSize")
        if not max then return end
        
        h:ChangeState(Enum.HumanoidStateType.Physics)
        r.Anchored = false
        grab:FireServer()
        eat:FireServer()
        st:FireServer()
        
        if ch.Value then 
            if t > 0 then n += 1 end
            t = 0
            g += dt 
        else 
            t += dt
            g = 0 
        end
        
        if t > 60 then h.Health = 0; t = 0; n = 0 end
        if g > 15 then s.Value = max.Value end
        
        if s.Value >= max.Value or t > 8 then
            if t < 8 then sell:FireServer() end
            Events.SetServerSettings:FireServer({MapTime = -1, Paused = true})
            n = 0
        elseif s.Value == 0 then end
        
        local bound = 300
        local y = bed.Position.Y + bed.Size.Y / 2 + h.HipHeight + r.Size.Y / 2
        local rr = rad.Value * 1.1
        local d = rr * n
        local x = d % bound
        local z = math.floor(d / bound) * rr
        
        if z > bound then 
            Events.SetServerSettings:FireServer({MapTime = -1, Paused = true})
            n = 0 
        end
        r.CFrame = CFrame.new(-bound / 2 + x, y, -bound / 2 + z + rr * 2)
    end)
end

local function setFarm(v)
    if v then farm = true; startFarm() else stopFarm() end
end

local function setCollect(v)
    collect = v
    if v and not cc then
        cc = task.spawn(function()
            local ps = LocalPlayer:FindFirstChild("PlayerScripts")
            local cv = ps and ps:FindFirstChild("CubeVis")
            if cv then cv.Enabled = false end
            while collect do
                task.wait()
                local c = LocalPlayer.Character
                local r = c and c:FindFirstChild("HumanoidRootPart")
                if r then 
                    for _, x in ipairs(workspace:GetChildren()) do
                        if x.Name == "Cube" and x:FindFirstChild("Owner") and (x.Owner.Value == LocalPlayer.Name or x.Owner.Value == "") then 
                            x.CFrame = r.CFrame 
                        end
                    end 
                end
            end
            if cv then cv.Enabled = true end
            cc = nil
        end)
    end
end

local function setClaim(v)
    claim = v
    if v then 
        task.spawn(function()
            while claim do
                task.wait(1)
                local tr = LocalPlayer:FindFirstChild("TimedRewards")
                if tr then 
                    for _, reward in ipairs(tr:GetChildren()) do
                        if reward:IsA("ValueBase") and reward.Value > 0 then 
                            Events.RewardEvent:FireServer(reward) 
                        end
                    end 
                end
                local spin = Events:FindFirstChild("SpinEvent")
                if spin then spin:FireServer() end
            end
        end) 
    end
end

