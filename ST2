-- --------------------------------------------------------------------
-- X-RAY / ESP LOGIC
-- --------------------------------------------------------------------
local espEnabled = false
local espConnections = {}
local playerInfos = {}

local function cleanupESPForPlayer(player)
    if not player then return end
    local info = playerInfos[player.UserId]
    if not info then return end

    if info.billboardGui and info.billboardGui.Parent then
        info.billboardGui:Destroy()
    end

    if info.character and info.character.Parent then
        for _, part in ipairs(info.character:GetDescendants()) do
            if part.Name == "ESPSurface" then
                part:Destroy()
            end
        end
    end

    playerInfos[player.UserId] = nil
end

local function createESPForPlayer(player)
    if not player or player == LocalPlayer then return end
    local character = player.Character
    if not character or not character:FindFirstChild("Head") then return end

    cleanupESPForPlayer(player)

    for _, part in ipairs(character:GetChildren()) do
        if (part:IsA("MeshPart") or part:IsA("Part")) and part.Name ~= "HumanoidRootPart" then
            for _, face in ipairs({
                Enum.NormalId.Front,
                Enum.NormalId.Back,
                Enum.NormalId.Left,
                Enum.NormalId.Right,
                Enum.NormalId.Top,
                Enum.NormalId.Bottom
            }) do
                local surfaceGui = Instance.new("SurfaceGui")
                surfaceGui.Name = "ESPSurface"
                surfaceGui.Face = face
                surfaceGui.AlwaysOnTop = true
                surfaceGui.Parent = part

                local frame = Instance.new("Frame")
                frame.Size = UDim2.new(1, 0, 1, 0)
                frame.BackgroundColor3 = Color3.new(1, 0, 0)
                frame.BackgroundTransparency = 0.5
                frame.BorderSizePixel = 0
                frame.Parent = surfaceGui
            end
        end
    end

    local head = character:FindFirstChild("Head")
    if head then
        local billboardGui = Instance.new("BillboardGui")
        billboardGui.Name = "ESPNameTag"
        billboardGui.Adornee = head
        billboardGui.Size = UDim2.new(0, 200, 0, 40)
        billboardGui.StudsOffset = Vector3.new(0, 3, 0)
        billboardGui.AlwaysOnTop = true
        billboardGui.Parent = head

        local nameLabel = Instance.new("TextLabel")
        nameLabel.BackgroundTransparency = 1
        nameLabel.Size = UDim2.new(1, 0, 0, 20)
        nameLabel.Font = Enum.Font.SourceSansBold
        nameLabel.Text = player.Name
        nameLabel.TextColor3 = Color3.new(1, 0, 0)
        nameLabel.TextSize = 14
        nameLabel.Parent = billboardGui

        local displayNameLabel = Instance.new("TextLabel")
        displayNameLabel.BackgroundTransparency = 1
        displayNameLabel.Position = UDim2.new(0, 0, 0, 20)
        displayNameLabel.Size = UDim2.new(1, 0, 0, 20)
        displayNameLabel.Font = Enum.Font.SourceSans
        displayNameLabel.Text = player.DisplayName
        displayNameLabel.TextColor3 = Color3.new(1, 1, 1)
        displayNameLabel.TextSize = 12
        displayNameLabel.Parent = billboardGui

        playerInfos[player.UserId] = {
            character = character,
            billboardGui = billboardGui
        }
    else
        playerInfos[player.UserId] = { character = character }
    end
end

local function updateESP()
    if not espEnabled then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            if character and character:FindFirstChild("Head") then
                local info = playerInfos[player.UserId]
                if not info or info.character ~= character then
                    createESPForPlayer(player)
                end
            else
                cleanupESPForPlayer(player)
            end
        end
    end
end

local function stopESP()
    for _, connection in ipairs(espConnections) do
        if connection and connection.Connected then
            connection:Disconnect()
        end
    end
    espConnections = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            cleanupESPForPlayer(player)
        end
    end
end

local function startESP()
    stopESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            createESPForPlayer(player)
            table.insert(espConnections, player.CharacterAdded:Connect(function()
                task.wait(0.5)
                if espEnabled then createESPForPlayer(player) end
            end))
        end
    end

    table.insert(espConnections, Players.PlayerAdded:Connect(function(player)
        if player == LocalPlayer then return end
        table.insert(espConnections, player.CharacterAdded:Connect(function()
            task.wait(0.5)
            if espEnabled then createESPForPlayer(player) end
        end))
        task.defer(function()
            if espEnabled then createESPForPlayer(player) end
        end)
    end))

    table.insert(espConnections, Players.PlayerRemoving:Connect(function(player)
        cleanupESPForPlayer(player)
    end))
    table.insert(espConnections, RunService.RenderStepped:Connect(updateESP))
end

figureSection:CreateToggle("X-Ray", function(enabled)
    espEnabled = enabled
    if espEnabled then
        startESP()
    else
        stopESP()
    end
end)
